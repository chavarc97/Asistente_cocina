# ==============================================
# CHEF BOT - ENVIRONMENT VARIABLES
# ==============================================

# === GENERAL ===
NODE_ENV=development
LOG_LEVEL=info

# === TELEGRAM BOT ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=http://n8n:5678/webhook/telegram

# === API GATEWAY ===
PORT=3000
ALLOWED_ORIGINS=*
API_GATEWAY_URL=http://api-gateway:3000

# === SERVICES URLs ===
RECIPE_SERVICE_URL=http://recipe-service:3001
USER_SERVICE_URL=http://user-service:3002

# === DATABASE (PostgreSQL) ===
POSTGRES_USER=chef_user
POSTGRES_PASSWORD=ChefSecure123!
POSTGRES_DB=chef_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Note: External port is 5433 (to avoid conflict), internal is 5432
DATABASE_URL=postgresql://chef_user:ChefSecure123!@postgres:5432/chef_db

# N8N Configuration
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=n8n_admin_123
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
# WEBHOOK_URL: Usar URL de ngrok aquí (ej: https://abc123.ngrok.io/)
WEBHOOK_URL=http://localhost:5678/

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=7d

# === REDIS CACHE ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# === EXTERNAL APIs ===
THEMEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1

# === SECURITY ===
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# === DEVELOPMENT ===
# ngrok URL for local development (update after running ngrok)
NGROK_URL=https://your-ngrok-url.ngrok.io
